generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MotorVoz {
  EDGE
  OPENAI
  ELEVENLABS
}

enum EstadoProyecto {
  BORRADOR
  GUION_GENERADO
  AUDIO_GENERADO
  EXPIRADO
}

model Usuario {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  // Cifradas con AES-256-GCM antes de salir de la aplicación: el nombre de la
  // columna lo deja claro en la propia base de datos. Ver src/lib/cifrado.js.
  apiKeyOpenAI  String?         @map("apiKeyOpenAICifrada")
  apiKeyEleven  String?         @map("apiKeyElevenCifrada")
  createdAt     DateTime        @default(now())
  proyectos     Proyecto[]
  perfilesCreados PerfilEmisora[]
}

model PerfilEmisora {
  id             String     @id @default(uuid())
  nombre         String
  tono           String
  camposContexto Json
  humorNegro     Boolean    @default(false)
  plantillasBase Json?
  esPublico      Boolean    @default(true)
  creadoPorId    String?
  creadoPor      Usuario?   @relation(fields: [creadoPorId], references: [id])
  proyectos      Proyecto[]
  createdAt      DateTime   @default(now())
}

model Proyecto {
  id              String         @id @default(uuid())
  nombre          String
  usuarioId       String
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  perfilId        String
  perfil          PerfilEmisora  @relation(fields: [perfilId], references: [id])
  contexto        Json
  motorVoz        MotorVoz       @default(EDGE)
  vozNombre       String?
  vozRate         String?
  vozPitch        String?
  estado          EstadoProyecto @default(BORRADOR)
  ultimaActividad DateTime       @default(now())
  createdAt       DateTime       @default(now())
  pistas          Pista[]
  lineasGuion     LineaGuion[]
}

model Pista {
  id         String   @id @default(uuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  titulo     String
  artista    String?
  orden      Int
  duracionMs Int?
}

model LineaGuion {
  id         String   @id @default(uuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  orden      Int
  texto      String
  precedeA   String?
}
