# Conexión a Postgres (Render)
DATABASE_URL=

# Puerto del servidor Express
PORT=3000

# Clave con la que se cifran las API keys que cada usuario vincula a su cuenta
# (OpenAI, ElevenLabs). 32 bytes en base64 o hexadecimal.
#
# Genérala con:  npm run generar-clave
#
# Si se pierde o se cambia, las API keys ya guardadas quedan irrecuperables y
# los usuarios tendrán que volver a vincularlas.
CLAVE_CIFRADO_API_KEYS=
